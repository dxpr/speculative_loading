{
    "name": "drupal/speculative_loading",
    "description": "Enables browsers to speculatively prerender or prefetch pages to achieve near-instant loads based on user interaction.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1.0",
        "drupal/core": "^10.3 || ^11"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "phpstan/phpstan": "^1.10",
        "mglaman/phpstan-drupal": "^1.2",
        "phpstan/extension-installer": "^1.3",
        "phpcompatibility/php-compatibility": "^9.3",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "scripts": {
        "phpcs": "phpcs --standard=Drupal,DrupalPractice --extensions=php,module,inc,install,test,profile,theme,css,info,txt,md --ignore=node_modules,vendor,dist .",
        "phpcbf": "phpcbf --standard=Drupal,DrupalPractice --extensions=php,module,inc,install,test,profile,theme,css,info,txt,md --ignore=node_modules,vendor,dist .",
        "drupal-check": "drupal-check src",
        "phpstan": "phpstan analyse -c phpstan.neon"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
} 