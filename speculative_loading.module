<?php

/**
 * @file
 * Provides speculation rules functionality.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\speculative_loading\Hook\SpeculativeLoadingHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function speculative_loading_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(SpeculativeLoadingHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function speculative_loading_page_attachments(array &$attachments) {
  \Drupal::service(SpeculativeLoadingHooks::class)->pageAttachments($attachments);
}
